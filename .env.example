# SupportFlow AI — Configuration
# Copy/rename this file to .env and fill in your keys

# ─── LLM Provider ──────────────────────────────────────────────────────────────
# Get your FREE Groq key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=qwen/qwen3.8-27b

# ─── Database (SQLite by default — no setup needed!) ──────────────────────────
# Leave this commented to use SQLite (recommended for local dev)
# DATABASE_URL=postgresql://user:pass@localhost:5432/supportflow_db

# ─── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET_KEY=supportflow_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── LangSmith Observability (optional) ───────────────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_key_here
# LANGCHAIN_PROJECT=SupportFlowAI
